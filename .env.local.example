# Copy this file to .env.local and fill in real values.

# SQLite database file (relative to project root). No changes needed for local dev.
DATABASE_URL="file:./prisma/dev.db"

# Get a free token at https://account.mapbox.com/access-tokens/
# Required for the Map page, the Photo Detail mini-map, and the admin location picker.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Admin login. Generate the hash with: node scripts/hash-password.mjs "your-password"
# IMPORTANT: bcrypt hashes contain literal "$" characters. Next.js expands
# $VAR-style references in .env files, so escape every "$" as "\$" here or
# your hash will be silently corrupted and login will always fail.
ADMIN_EMAIL="admin@gordonbirds.com"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign admin session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
