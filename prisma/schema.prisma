generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Species {
  id             String   @id @default(cuid())
  scientificName String   @unique
  commonName     String
  genus          String
  family         String
  order          String
  createdAt      DateTime @default(now())
  photos         Photo[]

  @@index([genus])
  @@index([family])
  @@index([order])
}

model Photo {
  id               String    @id @default(cuid())
  originalUrl      String
  optimizedUrl     String
  thumbnailUrl     String
  blurDataUrl      String?
  width            Int
  height           Int
  dateUploaded     DateTime  @default(now())
  datePhotographed DateTime?
  latitude         Float
  longitude        Float
  locationName     String
  country          String?
  region           String?
  placeName        String?
  photographer     String?
  sourceUrl        String?
  license          String?
  speciesId        String
  species          Species   @relation(fields: [speciesId], references: [id])

  @@index([speciesId])
  @@index([country])
  @@index([region])
}
